rules_version = '2';

// Keramika instance image rules.
//
// Product instance images are stored under products/<productId>/<instanceId>/.
// They are publicly readable (the eshop displays them) and writable only by
// authenticated admins (custom claim `admin == true`).
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
