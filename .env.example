# Firebase web app configuration for the DEPLOYED site (set these in Vercel).
# Local runs never use them: the dev server, preview and tests always talk to
# the local emulator suite (`pnpm emulators`), so they can stay empty here.
# These PUBLIC_ values are shipped to the browser and are NOT secret; access is
# controlled by Firebase Security Rules and Firebase Authentication. Values
# come from the Firebase console (Project settings > Your apps > Web app > SDK
# setup and configuration), or run:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Server-only (never PUBLIC_), deployed site only: service-account key for the
# Admin SDK, as the key file's JSON base64-encoded. See docs/deployment.md.
FIREBASE_SERVICE_ACCOUNT_KEY=
