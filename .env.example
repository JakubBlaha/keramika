# Firebase web app configuration.
# These PUBLIC_ values are shipped to the browser and are NOT secret; access is
# controlled by Firebase Security Rules and Firebase Authentication. Copy this
# file to .env and fill in the values from the Firebase console (Project
# settings > Your apps > Web app > SDK setup and configuration), or run:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the Firebase client at the local emulator suite
# (used by the e2e checkout tests). Leave empty/unset for the real backend.
PUBLIC_FIREBASE_EMULATOR=

# Seed admin used by scripts/seed.mjs
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
