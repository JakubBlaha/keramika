rules_version = '2';

// Keramika catalog rules.
//
// Data model (see docs/requirements/admin.md):
//   categories/{categoryId}
//   products/{productId}          (product carries its instances)
//
// The public eshop reads categories and products; only authenticated admins
// (users whose auth token carries a custom claim `admin == true`) may write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Any nested subcollections (e.g. instances) inherit the same policy.
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
